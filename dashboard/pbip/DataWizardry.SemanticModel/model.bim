            "summarizeBy": "none"
          },
          {
            "name": "is_focus_category",
            "dataType": "boolean",
            "sourceColumn": "is_focus_category",
            "summarizeBy": "none"
          },
          {
            "name": "is_total_retail",
            "dataType": "boolean",
            "sourceColumn": "is_total_retail",
            "summarizeBy": "none"
          },
          {
            "name": "date_key",
            "dataType": "int64",
            "sourceColumn": "date_key",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_retail_monthly-partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(\"E:\\\\ProjectsUploadedToGit\\\\data-wizardry-in-hogwarts\\\\dashboard\\\\model\\\\fact_retail_monthly.csv\"),[Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    Typed = Table.TransformColumnTypes(Promoted,{{\"naics_code\", type text}, {\"naics_name\", type text}, {\"sales_thousands_cad\", type number}, {\"sales_thousands_cad_real\", type number}, {\"is_focus_category\", type logical}, {\"is_total_retail\", type logical}, {\"date_key\", Int64.Type}})\nin\n    Typed"
            }
          }
        ]
      },
      {
        "name": "Key Measures",
        "columns": [
          {
            "name": "placeholder",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "placeholder",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Key Measures-partition",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = #table({\"placeholder\"}, {{\"\"}}) in Source"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Budget",
            "expression": "SUM ( fact_film_performance[budget_usd] )",
            "formatString": "\\$#,0"
          },
          {
            "name": "Total Worldwide Gross",
            "expression": "SUM ( fact_film_performance[worldwide_gross_usd] )",
            "formatString": "\\$#,0"
          },
          {
            "name": "Profit",
            "expression": "[Total Worldwide Gross] - [Total Budget]",
            "formatString": "\\$#,0"
          },
          {
            "name": "Profit Margin",
            "expression": "DIVIDE ( [Profit], [Total Worldwide Gross] )",
            "formatString": "0.0%"
          },
          {
            "name": "Return on Budget",
            "expression": "DIVIDE ( [Total Worldwide Gross], [Total Budget] )",
            "formatString": "0.00"
          },
          {
            "name": "Cumulative Franchise Revenue",
            "expression": "CALCULATE ( [Total Worldwide Gross], FILTER ( ALLSELECTED ( dim_date[date_key] ), dim_date[date_key] <= MAX ( dim_date[date_key] ) ) )",
            "formatString": "\\$#,0"
          },
          {
            "name": "Mean Weekly Attention",
            "expression": "AVERAGE ( fact_attention_monthly[mean_weekly_value] )",
            "formatString": "#,0"
          },
          {
            "name": "Attention YoY Change",
            "expression": "VAR CurrentValue = [Mean Weekly Attention] VAR PriorValue = CALCULATE ( [Mean Weekly Attention], DATEADD ( dim_date[month_start], -12, MONTH ) ) RETURN DIVIDE ( CurrentValue - PriorValue, PriorValue )",
            "formatString": "0.0%"
          },
          {
            "name": "Franchise Attention",
            "expression": "CALCULATE ( [Mean Weekly Attention], fact_attention_monthly[source] = \"wikipedia_pageviews\", fact_attention_monthly[group] = \"franchise\" )",
            "formatString": "#,0"
          },
          {
            "name": "Category Sales Real",
            "expression": "CALCULATE ( SUM ( fact_retail_monthly[sales_thousands_cad_real] ), fact_retail_monthly[is_focus_category] = TRUE () )",
            "formatString": "#,0"
          },
          {
            "name": "Total Retail Sales Real",
            "expression": "CALCULATE ( SUM ( fact_retail_monthly[sales_thousands_cad_real] ), fact_retail_monthly[is_total_retail] = TRUE () )",
            "formatString": "#,0"
          },
          {
            "name": "Seasonality Index",
            "expression": "VAR MonthlyValue = [Category Sales Real] VAR AnnualAverage = CALCULATE ( AVERAGEX ( VALUES ( dim_date[date_key] ), [Category Sales Real] ), ALLEXCEPT ( dim_date, dim_date[year] ) ) RETURN DIVIDE ( MonthlyValue, AnnualAverage ) * 100",
            "formatString": "0.0"
          },
          {
            "name": "Category Share of Total Retail",
            "expression": "DIVIDE ( [Category Sales Real], [Total Retail Sales Real] )",
            "formatString": "0.0%"
          },
          {
            "name": "Total Pieces",
            "expression": "SUM ( fact_product_release[num_parts] )",
            "formatString": "#,0"
          },
          {
            "name": "Average Price Per Piece",
            "expression": "AVERAGE ( fact_product_release[price_per_piece_cad] )",
            "formatString": "\\$#,0.00"
          },
          {
            "name": "Total Attendance",
            "expression": "SUM ( fact_park_attendance[attendance] )",
            "formatString": "#,0"
          },
          {
            "name": "Attendance Index vs Pre-Opening",
            "expression": "AVERAGE ( fact_park_attendance[attendance_index_vs_year_before_opening] )",
            "formatString": "0.0"
          },
          {
            "name": "Set Count",
            "expression": "COUNTROWS ( fact_product_release )",
            "formatString": "#,0"
          },
          {
            "name": "Film Count",
            "expression": "COUNTROWS ( fact_film_performance )",
            "formatString": "#,0"
          },
          {
            "name": "Critic Audience Gap",
            "expression": "AVERAGE ( fact_film_performance[critic_audience_gap] )",
            "formatString": "0.0"
          }
        ]
      }
    ],
