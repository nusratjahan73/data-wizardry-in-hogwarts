# Secrets. Never commit a real key. Only .env.example is tracked.
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
praw.ini

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Collected data. The repository ships the code that rebuilds these, not the
# pulls themselves. data/external is tracked because it is hand entered and
# cannot be regenerated by a script.
data/raw/**
data/cleaned/**
data/processed/**
!data/processed/.gitkeep

# Large or regenerable build products
outputs/models/*.joblib
outputs/models/*.pkl
logs/*.log
dashboard/*.pbix

# Big data corpora and their shards
*.parquet
!outputs/tables/*.parquet

# OS and editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
