# Keeping secrets out. I never commit a real key. Only .env.example is tracked.
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
praw.ini

# Ignoring Python cache and environment folders.
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Leaving out the collected data. I share the code that rebuilds it, not the
# data itself. I track data/external because I enter it by hand and no script
# can rebuild it.
data/raw/**
data/cleaned/**
data/processed/**
!data/processed/.gitkeep

# Leaving out large files that my code can build again.
outputs/models/*.joblib
outputs/models/*.pkl
logs/*.log

# Leaving out big data files and their parts.
*.parquet
!outputs/tables/*.parquet

# Ignoring files that the operating system or my editor creates.
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
