# Copy this file to .env and fill in the values. .env is git ignored.
# Never write a real key into any other file, including config.yaml.
# A missing key is not a crash: the collection script logs the missing name,
# writes a line to logs/data_issues.md and skips that source cleanly.

# Rebrickable. Free account, key issued instantly from the account settings page.
# Used by src/collect/06_rebrickable.py for set metadata and piece counts.
REBRICKABLE_API_KEY=

# Brickset. Free API key requested from the Brickset site. This is the price
# source, because Rebrickable carries no retail price.
BRICKSET_API_KEY=

# Reddit. Create a script type application at reddit.com/prefs/apps.
# The user agent must identify the project and a contact, per Reddit's rules.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=data-wizardry-in-hogwarts/1.0 by u/your_reddit_username

# Salt for hashing Reddit usernames at the point of collection. Any long random
# string. Keeping it out of the repository means the hashes cannot be reversed
# by anyone reading the code. See module 8.
REDDIT_HASH_SALT=
