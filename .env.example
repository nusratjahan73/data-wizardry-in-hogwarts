# Copying this file to .env and filling in the values. Git ignores my .env file.
# I never put a real key in any other file, and not in config.yaml either.
# A missing key does not crash anything. The collection script logs the missing
# name, adds a line to logs/data_issues.md and skips that source.

# Leaving this empty is fine. src/collect/06_rebrickable.py gets all its data from Rebrickable's
# free bulk files, which need no key. A key only adds an optional cross check against their API.
REBRICKABLE_API_KEY=

# Using Brickset with a free API key that I ask for on the Brickset site. This
# is my price source, because Rebrickable has no retail price.
BRICKSET_API_KEY=

# Using Reddit. I create a script type application at reddit.com/prefs/apps.
# The user agent must name the project and a contact, as Reddit's rules ask.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=data-wizardry-in-hogwarts/1.0 by u/your_reddit_username

# Hashing Reddit usernames with this salt at the moment I collect them. Any long
# random text works. I keep it out of the repository so nobody reading the code
# can turn the hashes back into names. See module 8.
REDDIT_HASH_SALT=
